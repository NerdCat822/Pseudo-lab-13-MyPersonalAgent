# Required, at least 32 characters. Generate one with: openssl rand -hex 32
# "change-me" is a placeholder that is deliberately REJECTED at startup; replace it.
MEETING_API_TOKEN=change-me
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/meeting_api.db
# MAX_UPLOAD_MB=200
# ENABLE_DOCS=false   # true exposes /docs, /redoc and /openapi.json (still behind the token)

# OpenAI API key for the transcription/summary worker (sk-...). Empty = worker disabled,
# uploads are stored but stay in status "received".
OPENAI_API_KEY=
# TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize   # the only OpenAI model with speaker labels
# SUMMARY_MODEL=gpt-5-mini
# WORKER_ENABLED=true
# WORKER_POLL_SEC=2
# SEGMENT_MAX_RETRIES=3
